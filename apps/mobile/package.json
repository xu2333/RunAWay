{
  "name": "runaway-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "sync": "npm run build && cap sync",
    "test": "node --test tests/*.test.mjs",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "ios:personal": "npm run sync && node prepare-personal-signing.mjs --open"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.25.12",
    "playwright-core": "1.65.1"
  }
}
